{
  "__inputs": [],
  "__requires": [],
  "title": "Bookstore - Application Performance",
  "description": "Application-level metrics for Bookstore API",
  "uid": "bookstore-app-perf",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["bookstore", "application", "spring"],
  "timezone": "utc",
  "editable": false,
  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"bookstore-api\"}[5m]))",
          "legendFormat": "Requests/sec"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "HTTP Error Rate (4xx/5xx)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"bookstore-api\", status=~\"4..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"bookstore-api\"}[5m])) * 100",
          "legendFormat": "4xx %"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"bookstore-api\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"bookstore-api\"}[5m])) * 100",
          "legendFormat": "5xx %"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "P99/P95/P50 Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"bookstore-api\"}[5m])) by (le))",
          "legendFormat": "P99"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"bookstore-api\"}[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"bookstore-api\"}[5m])) by (le))",
          "legendFormat": "P50"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    },
    {
      "title": "JVM Heap Memory",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by(instance) (jvm_memory_used_bytes{application=\"bookstore-api\", area=\"heap\"})",
          "legendFormat": "Used: {{ instance }}"
        },
        {
          "expr": "sum by(instance) (jvm_memory_max_bytes{application=\"bookstore-api\", area=\"heap\"})",
          "legendFormat": "Max: {{ instance }}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "title": "JVM Non-Heap Memory",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by(instance) (jvm_memory_used_bytes{application=\"bookstore-api\", area=\"nonheap\"})",
          "legendFormat": "Used: {{ instance }}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    },
    {
      "title": "JVM Garbage Collection",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"bookstore-api\"}[5m])",
          "legendFormat": "GC Pause Time"
        },
        {
          "expr": "rate(jvm_gc_pause_seconds_count{application=\"bookstore-api\"}[5m])",
          "legendFormat": "GC Count"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 }
    },
    {
      "title": "Database Connection Pool",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"bookstore-api\"}",
          "legendFormat": "Active"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"bookstore-api\"}",
          "legendFormat": "Idle"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"bookstore-api\"}",
          "legendFormat": "Pending"
        },
        {
          "expr": "hikaricp_connections_max{application=\"bookstore-api\"}",
          "legendFormat": "Max"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 }
    },
    {
      "title": "Cache Hit/Miss Ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(cache_gets_total{application=\"bookstore-api\"}[5m])",
          "legendFormat": "Gets"
        },
        {
          "expr": "rate(cache_hits_total{application=\"bookstore-api\"}[5m])",
          "legendFormat": "Hits"
        },
        {
          "expr": "rate(cache_misses_total{application=\"bookstore-api\"}[5m])",
          "legendFormat": "Misses"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 }
    },
    {
      "title": "Kafka Message Throughput",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(kafka_producer_record_send_total{application=\"bookstore-api\"}[5m])",
          "legendFormat": "Produced"
        },
        {
          "expr": "rate(kafka_consumer_records_consumed_total{application=\"bookstore-api\"}[5m])",
          "legendFormat": "Consumed"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 }
    }
  ]
}
