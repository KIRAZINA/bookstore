<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">
    <!-- EI_EXPOSE_REP/EI_EXPOSE_REP2 are inherent to JPA entities, Spring-managed beans,
         configuration properties and value records in this codebase; defensive copies would
         break Hibernate field access and Jackson/Spring binding. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- VA_FORMAT_STRING_USES_NEWLINE is a false positive on Java text blocks used as
         .formatted() format strings (SpotBugs cannot see text-block line separators). -->
    <Match>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>
    <!-- CT_CONSTRUCTOR_THROW flags theoretical finalizer attacks on partially initialized
         objects; Spring beans intentionally fail fast during construction and finalizers are
         being removed from the JVM. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>